# Copy to .env and fill in the secrets. Never commit .env.

# Direct Postgres connection (Supabase session pooler) — migrations/seeds via psql
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Supabase API — used by the Express backend via supabase-js
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role (secret) key: Dashboard -> Project Settings -> API keys.
# Server-side only. NEVER expose to the frontend or logs.
SUPABASE_SERVICE_ROLE_KEY=
# Anon (public) key: Dashboard -> Project Settings -> API keys.
# Used only for user-auth calls (sign in) — never for data access.
SUPABASE_ANON_KEY=

# Express
PORT=4000

# Optional: override what the API considers "today" (YYYY-MM-DD).
# Set while demoing with seed data; leave unset in production.
# APP_TODAY=2026-06-30
